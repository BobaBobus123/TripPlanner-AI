# Copy to .env only when local overrides are needed. No credentials are required for mock mode.
APP_ENV=development
PROVIDER=mock
STORAGE_BACKEND=memory
MOCK_FAILURE_MODE=none
MOCK_DELAY_SECONDS=0.05
RECORDED_MODE=disabled
RECORDED_PATH=recordings/plans.jsonl

# Required only for PROVIDER=openai_compat and non-replay mode.
# OPENAI_COMPAT_API_KEY=replace-me
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_MODEL=your-model-name
# Illustrative only: replace both token prices with current model pricing.
# INPUT_COST_PER_MILLION_TOKENS=0.15
# OUTPUT_COST_PER_MILLION_TOKENS=0.60
# DAILY_BUDGET_USD=5.00
# MAX_CONTEXT_TOKENS=3000
# MAX_OUTPUT_TOKENS=2000
# PROVIDER_TIMEOUT_SECONDS=30
# OVERALL_DEADLINE_SECONDS=45
