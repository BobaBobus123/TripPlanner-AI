# Copy to .env only when local overrides are needed. No credentials are required for mock mode.
APP_ENV=development
PROVIDER=mock
STORAGE_BACKEND=memory
# Email address allowed to change the global AI mode in the web interface.
# APP_ADMIN_EMAIL=you@example.com
# Required for STORAGE_BACKEND=postgres; use a private PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/database
SESSION_TTL_HOURS=336
# Defaults to Secure cookies only when APP_ENV=production.
# SESSION_COOKIE_SECURE=true
EMAIL_BACKEND=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
EMAIL_VERIFICATION_TTL_MINUTES=30

# Local development returns a one-time verification link in the browser instead of sending email.
# Production requires SMTP and HTTPS:
# APP_ENV=production
# EMAIL_BACKEND=smtp
# PUBLIC_BASE_URL=https://your-domain.example
# EMAIL_FROM=TripPlanner AI <no-reply@your-domain.example>
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_USERNAME=your-smtp-user
# SMTP_PASSWORD=replace-me
# SMTP_STARTTLS=true

WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=90
MOCK_FAILURE_MODE=none
MOCK_DELAY_SECONDS=0.05
RECORDED_MODE=disabled
RECORDED_PATH=recordings/plans.jsonl

# Required only for PROVIDER=openai_compat and non-replay mode.
# OPENAI_COMPAT_API_KEY=replace-me
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_MODEL=your-model-name
# Illustrative only: replace both token prices with current model pricing.
# INPUT_COST_PER_MILLION_TOKENS=0.15
# OUTPUT_COST_PER_MILLION_TOKENS=0.60
# DAILY_BUDGET_USD=5.00
# MAX_CONTEXT_TOKENS=3000
# MAX_OUTPUT_TOKENS=2000
# PROVIDER_TIMEOUT_SECONDS=30
# OVERALL_DEADLINE_SECONDS=45
